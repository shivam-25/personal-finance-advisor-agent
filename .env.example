# Copy to .env and fill in. The prototype runs fully without any of these:
# with no key the agents use their deterministic reasoning and the JSON-file
# memory backend.

# --- Optional: LLM narration + intent disambiguation (OpenRouter) ----------
OPENROUTER_API_KEY=
ADVISOR_MODEL=google/gemini-2.5-flash
# Set to 1 to force the deterministic path even when a key is present.
ADVISOR_DISABLE_LLM=0

# --- Optional: durable long-term memory (Supabase) ------------------------
# Needed only on serverless hosts, where the filesystem is ephemeral.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEMORY_TABLE=advisor_memory

# --- Local memory location when Supabase is not configured ----------------
ADVISOR_MEMORY_DIR=.advisor-memory
